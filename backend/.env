PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173

# --- Payment Gateway (SANDBOX / TEST MODE) ---
# This project ships with a built-in mock payment gateway that behaves like
# Stripe/Razorpay test mode (see backend/routes/payment.js) so it runs with
# zero external setup. To use REAL Stripe test keys instead, set:
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYMENT_PROVIDER=mock